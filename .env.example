# StoryOps / editorial-kit environment variables. All are optional.
# Copy to .env only if you need them. .env is git-ignored and is never read
# by evidence collection.

# Path to a Chromium/Chrome executable when Playwright's bundled browser is not installed.
# EDITORIAL_CHROMIUM_PATH=/path/to/chrome

# Override the User-Agent contact suffix used for polite public research requests.
# EDITORIAL_USER_AGENT_CONTACT=https://example.com/contact

# Log level: error | warn | info | debug
# EDITORIAL_LOG_LEVEL=info
