# StoryOps environment variables. All are optional.
# Copy to .env only if you need them. .env is git-ignored and is never read
# by repository analysis. The older EDITORIAL_* names are still honoured.

# Path to a Chromium/Chrome executable for the optional screenshot utility.
# STORYOPS_CHROMIUM_PATH=/path/to/chrome

# Contact suffix for the User-Agent of polite public research requests.
# STORYOPS_USER_AGENT_CONTACT=https://example.com/contact

# Log level: error | warn | info | debug
# STORYOPS_LOG_LEVEL=info
